DirectoryIndex index.html

<IfModule mod_rewrite.c>
RewriteEngine On

# Preserve ACME/AutoSSL validation paths.
RewriteRule ^\.well-known/acme-challenge/ - [L]

# Canonical host: sempre sem www.
RewriteCond %{HTTP_HOST} ^www\.concretobrasils\.online$ [NC]
RewriteRule ^ https://concretobrasils.online%{REQUEST_URI} [R=301,L,NE]

# Home explícita.
RewriteRule ^$ index.html [L]

# A página antiga de orçamento foi removida de forma definitiva.
RewriteRule ^orcamento/?$ - [G,L]

# Remove index.html apenas quando solicitado diretamente pelo navegador.
RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html(?:[?\s]) [NC]
RewriteRule ^(.*/)?index\.html$ https://concretobrasils.online/$1 [R=301,L,NE]

# Páginas públicas.
RewriteRule ^produtos/?$ produtos/index.html [L]
RewriteRule ^sobre/?$ sobre/index.html [L]
RewriteRule ^concreto-usinado/?$ concreto-usinado/index.html [L]
RewriteRule ^bombeamento-de-concreto/?$ bombeamento-de-concreto/index.html [L]
RewriteRule ^politica-de-privacidade/?$ politica-de-privacidade/index.html [L]
RewriteRule ^termos/?$ termos/index.html [L]
</IfModule>

<IfModule mod_headers.c>
# Identificador temporário para confirmar qual versão o servidor está entregando.
Header always set X-Concreto-Deploy "20260828-cache3"

# Evita servir HTML/CSS/JS antigos em navegador, proxy ou cache intermediário.
<FilesMatch "\.(?:html|css|js|json|xml|txt)$">
Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0, s-maxage=0"
Header always set Pragma "no-cache"
Header always set Expires "0"
</FilesMatch>

# Durante o diagnóstico, também força revalidação das imagens.
<FilesMatch "\.(?:png|jpg|jpeg|webp|svg|ico)$">
Header always set Cache-Control "no-cache, must-revalidate, max-age=0"
</FilesMatch>

Header unset ETag
</IfModule>

<IfModule mod_expires.c>
ExpiresActive Off
</IfModule>

FileETag None
