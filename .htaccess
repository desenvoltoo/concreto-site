DirectoryIndex index.html
Options -Indexes

RewriteEngine On

# Preserve ACME/AutoSSL validation paths
RewriteRule ^\.well-known/acme-challenge/ - [L]

# Canonical host + HTTPS
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\.concretobrasils\.online$ [NC]
RewriteRule ^ https://concretobrasils.online%{REQUEST_URI} [R=301,L]

# Serve existing files and directories normally
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
