DirectoryIndex index.html
Options -Indexes

# Configuração mínima para máxima compatibilidade com crawlers e dispositivos.
# O anúncio já usa HTTPS diretamente, então evitamos redirects no Apache.

<IfModule mod_rewrite.c>
RewriteEngine On

# Preserve ACME/AutoSSL validation paths.
RewriteRule ^\.well-known/acme-challenge/ - [L]
</IfModule>
